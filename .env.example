# Where the survey app posts a completed response.
# Leave unset to use the built-in /api/send-report endpoint.
VITE_REPORT_ENDPOINT=/api/send-report

# --- Server-side only (set these in your host's dashboard, never in the app) ---

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where completed survey reports are emailed.
REPORT_TO_EMAIL=you@example.com

# A verified sender on a domain you own in Resend.
REPORT_FROM_EMAIL=survey@yourdomain.com
